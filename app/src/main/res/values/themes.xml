<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Home" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <!-- Opaque black so the system wallpaper never flashes through
             during a screen-swap reparent, when the window briefly has
             no rendered content. The launcher draws its own wallpaper
             layer in Compose on top of this. -->
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowShowWallpaper">true</item>
    </style>

    <style name="Theme.HomeRouter" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>