    <string name="jarnfe_first_run_welcome_title">Welcome to Jarn</string>
    <string name="jarnfe_first_run_welcome_body">Your games live on the top screen, called Stage. What you can do with them lives down here on the Deck.</string>
    <string name="jarnfe_first_run_welcome_body_single">Your games fill this screen, called Stage. The Deck opens as a panel whenever you need it.</string>

    <string name="jarnfe_first_run_library_title">Your games</string>
    <string name="jarnfe_first_run_library_why">Jarn only reads this folder to find your games.</string>
    <string name="jarnfe_first_run_library_loading">Looking for your games. You can keep going while this finishes.</string>
    <string name="jarnfe_first_run_library_later">You can add a game folder anytime from Settings, Library.</string>
    <string name="jarnfe_first_run_existing_title">Your setup is already here</string>
    <string name="jarnfe_first_run_existing_body">Nothing to import, and nothing was changed.</string>
    <plurals name="jarnfe_first_run_existing_systems">
        <item quantity="one">%1$d system</item>
        <item quantity="other">%1$d systems</item>
    </plurals>
