    <plurals name="jarnfe_first_run_existing_games">
        <item quantity="one">%1$d game</item>
        <item quantity="other">%1$d games</item>
    </plurals>

    <string name="jarnfe_first_run_media_title">Your art</string>
    <string name="jarnfe_first_run_media_intro">Jarn looks for box art you already have.</string>
    <string name="jarnfe_first_run_media_checking">Checking for art</string>
    <string name="jarnfe_first_run_media_found">Found %1$s, and using it</string>
    <string name="jarnfe_first_run_media_in_use">Using %1$s</string>
    <string name="jarnfe_first_run_media_elsewhere">Art found in %1$s</string>
    <string name="jarnfe_first_run_media_elsewhere_hint">Switch to it in the Art setting below.</string>
    <string name="jarnfe_first_run_media_none">No art found yet</string>
    <string name="jarnfe_first_run_media_none_hint">Your games still work. You can add art later.</string>
    <string name="jarnfe_first_run_media_esde_wins">RetroHrai art is here too. ES-DE comes first when both are found.</string>
    <string name="jarnfe_first_run_media_open">Art setting</string>
    <string name="jarnfe_first_run_media_open_hint">Switch your art source here. B brings you back.</string>
    <string name="jarnfe_first_run_media_access">Allow file access</string>
    <string name="jarnfe_first_run_media_access_why">Jarn needs file access to read art saved by other apps.</string>
    <string name="jarnfe_first_run_art_cue">Pick your art source here. Press B to return to the tour.</string>

    <string name="jarnfe_first_run_look_title">Pick a look</string>
    <string name="jarnfe_first_run_look_body">Move up to try one on both screens, and press A to keep it. Fjord is the default.</string>

    <string name="jarnfe_first_run_a_title">A selects</string>
    <string name="jarnfe_first_run_a_body">Press A to open or confirm whatever is highlighted.</string>
    <string name="jarnfe_first_run_b_title">B goes back</string>
    <string name="jarnfe_first_run_b_body">Press B to step back one level. Try it now.</string>
    <string name="jarnfe_first_run_x_title">X shows options</string>
    <string name="jarnfe_first_run_x_body">Press X on a game to see what you can do with it on the Deck. Try it now.</string>
    <string name="jarnfe_first_run_x_body_single">Press X on a game to open the Deck panel with its options. Try it now.</string>
    <string name="jarnfe_first_run_select_title">Select switches screens</string>
    <string name="jarnfe_first_run_select_body">Press Select to move your controller to the other screen. Try it now.</string>
    <string name="jarnfe_first_run_tabs_title">L1 and R1 change tabs</string>
    <string name="jarnfe_first_run_tabs_body">Press L1 or R1 to move between tabs on this screen.</string>
    <string name="jarnfe_first_run_other_tabs_title">L2 and R2 reach across</string>
    <string name="jarnfe_first_run_other_tabs_body">Press L2 or R2 to change tabs on the other screen without leaving this one.</string>

    <string name="jarnfe_first_run_done_title">You\'re all set</string>
    <string name="jarnfe_first_run_done_body">Here are your buttons. Replay this tour anytime from Settings, General.</string>
    <string name="jarnfe_first_run_cheat_a">Open or confirm</string>
    <string name="jarnfe_first_run_cheat_b">Go back</string>
