#!/usr/bin/env python3
"""Fake adb that simulates a Thor running Jarn FE. Configured with FAKE_* variables; logs to FAKE_LOG."""
import io
import json
import os
import sys

from PIL import Image, ImageDraw

STATE_FILE = os.environ["FAKE_STATE"]
PKG = "jr.brian.home.debug"
TOP = "4630946441858561667"
BOTTOM = "4630946482288158084"
LIBRARY = ["Systems", "Favorites", "Recent"]
DECK = ["Now", "Apps", "Canvas"]
SETTINGS = ["Library", "Art", "Look", "Display", "Data"]


def env(name, default=""):
    return os.environ.get("FAKE_" + name, default)


def load():
    if os.path.exists(STATE_FILE):
        with open(STATE_FILE) as handle:
            return json.load(handle)
    return {"active": int(env("START_DISPLAY", "0")), "library": 1, "deck": int(env("DECK_TAB", "0")),
            "settings": 0, "route": "library",
            "stage_focus": 2, "deck_focus": 0, "lock": env("LOCK", "1"), "foreign": False}


def save(state):
    with open(STATE_FILE, "w") as handle:
        json.dump(state, handle)


def clamp(value, items):
    return max(0, min(value, len(items) - 1))


def press(state, code):
    in_settings = state["route"] == "settings"
    if code == 109:
        state["active"] = 4 if state["active"] == 0 else 0
    elif code == 108 and not in_settings:
        state["route"] = "settings"
        state["return"] = state["active"]
        state["active"] = 4
    elif code == 97:
        if in_settings:
            state["route"] = "library"
            state["active"] = state.get("return", 0)
        else:
            state["active"] = 0
    elif code in (102, 103):
        delta = 1 if code == 103 else -1
        if in_settings:
            state["settings"] = clamp(state["settings"] + delta, SETTINGS)
        elif state["active"] == 0:
            state["library"] = clamp(state["library"] + delta, LIBRARY)
        else:
            state["deck"] = clamp(state["deck"] + delta, DECK)
    elif code in (19, 20, 21, 22):
        move_focus(state, code)
    if env("FOLLOW_WRITES") and code in (108, 109, 97):
        state["lock"] = "2" if state["active"] == 4 else "1"
    if env("FOREIGN_AFTER") and code == int(env("FOREIGN_AFTER")):
        state["foreign"] = True


def move_focus(state, code):
    if state["active"] == 4:
        state["deck_focus"] = (state["deck_focus"] + 1) % 5
        if env("DPAD_LEAK"):
            state["stage_focus"] = (state["stage_focus"] + 1) % 5
        return
    if state["stage_focus"] == 0:
        if code == 20:
            state["stage_focus"] = 2
        elif code in (21, 22):
            state["library"] = clamp(state["library"] + (1 if code == 22 else -1), LIBRARY)
    elif code == 19:
        state["stage_focus"] = max(0, state["stage_focus"] - 1)
    elif code == 20:
        state["stage_focus"] = min(4, state["stage_focus"] + 1)
    if env("DPAD_LEAK"):
        state["deck_focus"] = (state["deck_focus"] + 1) % 5


def node(text, selected=False, focused=False):
    return (f'<node text="{text}" content-desc="" selected="{str(selected).lower()}" '
            f'focused="{str(focused).lower()}" bounds="[0,0][10,10]" />')


def ui_xml(state):
    if env("UI_FAIL"):
        return "ERROR: could not get idle state.\n"
    if env("UI_LAG"):
        shown = state.get("ui_shown", state["active"])
        if shown != state["active"]:
            state["ui_lag_reads"] = state.get("ui_lag_reads", 0) + 1
            if state["ui_lag_reads"] < int(env("UI_LAG")):
                other = dict(state, active=shown)
                return ui_body(other)
        state["ui_lag_reads"] = 0
        state["ui_shown"] = state["active"]
    return ui_body(state)


def ui_body(state):
    if state["active"] == 4 and env("DECK_UNREADABLE"):
        return '<?xml version="1.0"?><hierarchy rotation="0"><node text="" /></hierarchy>'
    parts = []
    if state["active"] == 0:
        parts.append(node("JARN"))
        if state["route"] == "library":
            for index, name in enumerate(LIBRARY):
                parts.append(node(name, index == state["library"],
                                  state["stage_focus"] == 0 and index == state["library"]))
        parts.append(node("Switch screen"))
        if state["route"] != "library":
            parts.append(node("Back"))
    elif state["route"] == "settings":
        for index, name in enumerate(SETTINGS):
            parts.append(node(name, index == state["settings"]))
        parts.extend([node("Back"), node("Switch screen")])
    else:
        for index, name in enumerate(DECK):
            parts.append(node(name, index == state["deck"]))
        parts.extend([node("Back"), node("Switch screen")])
    return '<?xml version="1.0"?><hierarchy rotation="0">' + "".join(parts) + "</hierarchy>"


def png(state, physical):
    tick = state.get("ticks", 0)
    state["ticks"] = tick + 1
    image = Image.new("RGB", (960, 540), (20, 20, 30))
    draw = ImageDraw.Draw(image)
    draw.rectangle((0, 0, 959, 40), fill=(tick * 37 % 255, 40, 40))
    active_physical = TOP if state["active"] == 0 else BOTTOM
    if env("NOISY") and physical != active_physical:
        for x in range(0, 960, 20):
            draw.rectangle((x, 60, x + 18, 520), fill=((tick * 53 + x) % 255, 90, 90))
    if physical == TOP:
        draw.rectangle((700, 100, 900, 200), fill=(tick * 41 % 255, 120, 200))
        draw.rectangle((40, 420, 900, 520), fill=(40 + state["library"] * 70, 60, 120))
        slot = state["stage_focus"]
    else:
        slot = state["deck_focus"]
        tab = state["settings"] if state["route"] == "settings" else state["deck"]
        draw.rectangle((40, 420, 900, 520), fill=(40 + tab * 50, 200, 80))
        if env("DECK_FOLLOWS"):
            draw.rectangle((300, 100, 700, 280), fill=(30 + state["stage_focus"] * 45, 70, 150))
    if env("NO_FOCUS_MOVE"):
        slot = 1
    draw.rectangle((60 + slot * 110, 300, 150 + slot * 110, 400), outline=(255, 255, 255), width=6)
    buffer = io.BytesIO()
    image.save(buffer, "PNG")
    return buffer.getvalue()


def prefs(name):
    if name == "focus_lock_prefs.xml":
        mode = env("MODE", "Top")
        if mode == "MISSING":
            return None
        return f'<map><string name="focus_lock_mode">{mode}</string></map>'
    if name == "screen_assignment_prefs.xml":
        value = env("ASSIGNMENT", "FRONTEND_ON_TOP")
        return f'<map><string name="assignment">{value}</string></map>'
    if name == "jarnfe_look_prefs.xml":
        return f'<map><boolean name="hints_visible" value="{env("HINTS", "true")}" /></map>'
    return None


def focused_component(state):
    if state["foreign"]:
        return "com.other.app/.Main"
    cls = "JarnStageActivity" if state["active"] == 0 else "JarnDeckActivity"
    return f"{PKG}/jr.brian.jarnfe.shell.{cls}"


def padding():
    """Output past the pipe buffer, so a reader that quits at its first match breaks the pipe."""
    return "filler line for a long dump\n" * 40000 if env("HUGE_DUMPS") else ""


def dumpsys(state, args):
    target = args[0] if args else ""
    if target == "display":
        return f"uniqueId='local:{TOP}'\nuniqueId='local:{BOTTOM}'\n" + padding()
    if target == "window" and args[1:] == ["displays"]:
        stage = focused_component(state) if state["foreign"] else f"{PKG}/jr.brian.jarnfe.shell.JarnStageActivity"
        deck = focused_component(state) if state["foreign"] else f"{PKG}/jr.brian.jarnfe.shell.JarnDeckActivity"
        return (f"Display: mDisplayId=0 stacks=1\n  mFocusedApp=ActivityRecord{{a u0 {stage} t1}}\n"
                f"Display: mDisplayId=4 stacks=1\n  mFocusedApp=ActivityRecord{{b u0 {deck} t2}}\n")
    if target == "window":
        return f"  mTopFocusedDisplayId={state['active']}\n"
    if target == "activity":
        deck_line = "" if env("NO_DECK") else f"  ResumedActivity: ActivityRecord{{b u0 {PKG}/jr.brian.jarnfe.shell.JarnDeckActivity t2}}\n"
        return (f"Display #0 (activities from top to bottom):\n"
                f"  ResumedActivity: ActivityRecord{{a u0 {PKG}/jr.brian.jarnfe.shell.JarnStageActivity t1}}\n"
                f"Display #4 (activities from top to bottom):\n{deck_line}")
    if target == "package":
        body = "jr.brian.jarnfe.shell.JarnStageActivity\n" if env("RELEASE_LEAK") else "Activities: none\n"
        return body + padding()
    return ""


def shell(state, args):
    joined = " ".join(args)
    if args[:2] == ["input", "-d"]:
        press(state, int(args[-1]))
        return ""
    if args[0] == "dumpsys":
        return dumpsys(state, args[1:])
    if args[:3] == ["settings", "get", "system"]:
        return state["lock"] + "\n"
    if args[0] == "date":
        return "1000\n"
    if args[0] == "pidof":
        return "4242\n"
    if args[:2] == ["pm", "path"]:
        return "package:/data/app/base.apk\n"
    if args[0] == "run-as":
        if env("RUNAS_FAIL"):
            print("run-as: package not debuggable", file=sys.stderr)
            sys.exit(1)
        if args[2] == "ls":
            names = ["focus_lock_prefs.xml", "screen_assignment_prefs.xml", "jarnfe_look_prefs.xml"]
            return "\n".join(name for name in names if prefs(name) is not None) + "\n"
        return (prefs(args[3].split("/")[-1]) or "") + "\n"
    if args[0] == "logcat":
        if env("CRASH") and "crash" in args:
            return f"FATAL EXCEPTION: main\nProcess: {PKG}, PID: 4242\n" + padding()
        if env("ANR") and "system" in args:
            return f"ActivityManager: ANR in {PKG} (reason)\n" + padding()
        return ""
    if args[0] == "am":
        return "Status: ok\n"
    raise SystemExit(f"fake adb: unexpected shell command: {joined}")


def main():
    argv = sys.argv[1:]
    with open(os.environ["FAKE_LOG"], "a") as log:
        log.write(" ".join(argv) + "\n")
    if argv[:1] == ["devices"]:
        rows = env("DEVICES", "THOR1").split(",")
        print("List of devices attached")
        for row in filter(None, rows):
            print(f"{row}\tdevice")
        return
    state = load()
    if argv[0] == "shell":
        sys.stdout.write(shell(state, argv[1:]))
    elif argv[0] == "exec-out" and argv[1] == "screencap":
        data = png(state, argv[-1])
        sys.stdout.buffer.write(data)
    elif argv[0] == "exec-out":
        sys.stdout.write(ui_xml(state))
    else:
        raise SystemExit(f"fake adb: unexpected command: {argv}")
    save(state)


if __name__ == "__main__":
    main()
