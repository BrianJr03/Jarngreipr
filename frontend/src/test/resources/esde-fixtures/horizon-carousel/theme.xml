<theme>
    <variables>
        <accent>5AB4FF</accent>
        <artDir>./art/${system.theme}</artDir>
    </variables>
    <view name="system">
        <image name="backdrop">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>${artDir}/backdrop.webp</path>
        </image>
        <carousel name="systemCarousel">
            <type>horizontal</type>
            <pos>0 0.62</pos>
            <size>1 0.24</size>
            <maxItemCount>5</maxItemCount>
            <itemScale>1.3</itemScale>
            <staticImage>./logos/${system.theme}.svg</staticImage>
            <color>${accent}33</color>
        </carousel>
        <text name="systemInfo">
            <pos>0.5 0.9</pos>
            <origin>0.5 0</origin>
            <systemdata>gamecount</systemdata>
            <color>${accent}</color>
        </text>
    </view>
    <view name="gamelist">
        <textlist name="gamelistTextlist">
            <pos>0.04 0.18</pos>
            <size>0.44 0.7</size>
            <selectorColor>${accent}</selectorColor>
        </textlist>
        <image name="cover">
            <pos>0.74 0.5</pos>
            <origin>0.5 0.5</origin>
            <maxSize>0.4 0.6</maxSize>
            <imageType>cover</imageType>
        </image>
    </view>
    <aspectRatio name="4:3">
        <view name="system">
            <carousel name="systemCarousel">
                <maxItemCount>3</maxItemCount>
            </carousel>
        </view>
    </aspectRatio>
</theme>
